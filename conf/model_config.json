{
  "model_path": "training/",
  "version": "v2",
  "preprocessing": {
    "img_size": 380,
    "preserve_aspect_ratio": true,
    "normalize": {
      "mean": [0.485, 0.456, 0.406],
      "std": [0.229, 0.224, 0.225]
    },
    "padding_color": [0, 0, 0]
  },
  "model_urls": {
    "efficientnet_model.pth": "https://storage.googleapis.com/kyc-aml-model/document_classification/v2/efficientnet_model.pth",
    "class_indices.json": "https://storage.googleapis.com/kyc-aml-model/document_classification/v2/class_indices.json",
    "training_history.json": "https://storage.googleapis.com/kyc-aml-model/document_classification/v2/training_history.json"
  },
  "required_files": [
    "efficientnet_model.pth",
    "class_indices.json"
  ],
  "optional_files": [
    "training_history.json"
  ]
}
